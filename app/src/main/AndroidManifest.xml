<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      An appop rather than a runtime permission: it cannot be requested with a
      dialog, only granted by the user in Settings. Declared so the gate can
      show today's real counts instead of guessing.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Scoped package visibility. A launcher only ever needs to see activities that
      declare themselves launchable, so we ask for exactly that instead of the
      blanket QUERY_ALL_PACKAGES permission, which requires a Play Store
      declaration and is rejected for most use cases.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ShunyaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shunya">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Shunya">

            <!--
              HOME + DEFAULT is what makes Android offer this as a launcher.
              LAUNCHER is deliberately absent: the app has no place in an app
              drawer, because when it is working there is no app drawer.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The gate, shown over another app. Its own task and excluded from
          recents, so dismissing it never leaves a stray card behind that can be
          tapped straight back into the feed.
        -->
        <activity
            android:name=".service.InterruptActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity=".interrupt"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Shunya" />

        <service
            android:name=".service.FeedWatcher"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
